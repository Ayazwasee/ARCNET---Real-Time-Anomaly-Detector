# Optional Neo4j AuraDB or Local Docker Neo4j credentials
# Leave NEO4J_URI / NEO4J_PASSWORD blank to run in automatic In-Memory Forensic Fallback mode
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=arcnetpassword
NEO4J_DATABASE=neo4j

# Live Blockchain WebSocket Feed
BLOCKCHAIN_WS_URL=wss://ws.blockchain.info/inv

# Dynamic Graph & Phase 1/2 Detection Defaults
ARCNET_WINDOW_SECONDS=180
ARCNET_MAX_NODES=120
ARCNET_WHALE_BTC=2.0
ARCNET_FANOUT_THRESHOLD=6
ARCNET_FANIN_THRESHOLD=5
ARCNET_Z_THRESHOLD=2.6
ARCNET_ML_THRESHOLD=74.0
ARCNET_PARTITIONS=4

# Stream Recorder / Time-Travel Replay File Path
ARCNET_RECORDING_PATH=data/recorded_stream.jsonl
